# =============================================================================
# Zylos-Next v6.0 — Environment Variables Template
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite .env com valores reais no repositório.
# Referências: SECURITY.md, AGENTS.md, ARCHITECTURE.md
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Endereço de escuta do gateway (host:porta). Padrão: 127.0.0.1:3000
ZYLOS_LISTEN=0.0.0.0:8080
ZYLOS_ENV=development
# development | preview | qa | production
ZYLOS_LOG_LEVEL=debug
# trace | debug | info | warn | error
ZYLOS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Database (SQLite WAL)
# -----------------------------------------------------------------------------
ZYLOS_DB_PATH=./data/zylos.db
ZYLOS_DB_WAL_CHECKPOINT_INTERVAL_MS=30000
ZYLOS_DB_MAX_CONNECTIONS=16
ZYLOS_DB_BUSY_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# Authentication & Authorization
# -----------------------------------------------------------------------------
ZYLOS_JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
ZYLOS_JWT_EXPIRY_SECS=3600
ZYLOS_REFRESH_TOKEN_EXPIRY_SECS=86400
ZYLOS_RATE_LIMIT_PER_MIN=100
ZYLOS_ADMIN_API_KEY=CHANGE_ME_ADMIN_KEY

# -----------------------------------------------------------------------------
# LLM Provider (para Adversarial Panel e Skills Eval)
# -----------------------------------------------------------------------------
ZYLOS_LLM_PROVIDER=openai
# openai | anthropic | local | custom
ZYLOS_LLM_API_KEY=sk-CHANGE_ME
ZYLOS_LLM_MODEL=gpt-4o-mini
ZYLOS_LLM_BASE_URL=https://api.openai.com/v1
ZYLOS_LLM_MAX_TOKENS=4096
ZYLOS_LLM_TEMPERATURE=0.1

# -----------------------------------------------------------------------------
# Sandbox Configuration
# -----------------------------------------------------------------------------
ZYLOS_SANDBOX_WASM_MEMORY_LIMIT_MB=256
ZYLOS_SANDBOX_WASM_FUEL_LIMIT=1000000
ZYLOS_SANDBOX_DOCKER_NETWORK=zylos-sandbox-net
ZYLOS_SANDBOX_CONTAINER_CPU_LIMIT=1.0
ZYLOS_SANDBOX_CONTAINER_MEM_LIMIT_MB=512

# -----------------------------------------------------------------------------
# Vector Store (Memory System)
# -----------------------------------------------------------------------------
ZYLOS_VECTOR_STORE_BACKEND=sqlite
# sqlite | qdrant | lancedb
ZYLOS_QDRANT_URL=http://localhost:6333
ZYLOS_EMBEDDING_DIMENSION=1536
ZYLOS_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Live Communication
# -----------------------------------------------------------------------------
ZYLOS_WS_HEARTBEAT_INTERVAL_SECS=30
ZYLOS_SSE_BUFFER_SIZE=1024
ZYLOS_AG_UI_MAX_EVENTS_PER_SEC=100

# -----------------------------------------------------------------------------
# Mobile MCP Server
# -----------------------------------------------------------------------------
ZYLOS_MCP_ENABLED=true
ZYLOS_MCP_PORT=8081
ZYLOS_MCP_AUTH_TOKEN=CHANGE_ME_MCP_TOKEN

# -----------------------------------------------------------------------------
# Skills Registry
# -----------------------------------------------------------------------------
ZYLOS_SKILLS_INDEX_PATH=./skills/index.json
ZYLOS_SKILLS_SCHEMA_PATH=./skills/schemas/skill.schema.json
ZYLOS_SKILLS_DISCOVERY_TIMEOUT_MS=100

# -----------------------------------------------------------------------------
# Verification & Evaluation
# -----------------------------------------------------------------------------
ZYLOS_GUARDRAIL_TIMEOUT_MS=1
ZYLOS_ADVERSARIAL_PANEL_JUDGES=3
ZYLOS_EVAL_DATASET_PATH=./evals/datasets/latest
ZYLOS_EVAL_BASELINE_PATH=./evals/baselines/latest

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
ZYLOS_OTEL_EXPORTER=none
# none | stdout | otlp
ZYLOS_OTEL_ENDPOINT=http://localhost:4317
ZYLOS_METRICS_PORT=9090
ZYLOS_AUDIT_LOG_PATH=./data/audit.log

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
ZYLOS_SECRETS_ENCRYPTION_KEY=CHANGE_ME_AES256_KEY_32_BYTES
ZYLOS_TLS_CERT_PATH=
ZYLOS_TLS_KEY_PATH=
ZYLOS_GITLEAKS_ENABLED=true

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ZYLOS_FEATURE_SHADOW_GIT=true
ZYLOS_FEATURE_TREE_OF_THOUGHTS=false
ZYLOS_FEATURE_BROWSER_ANTIDETECT=false
ZYLOS_FEATURE_OCR_SIDECAR=false