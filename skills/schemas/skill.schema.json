{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Zylos Skill Schema v1.0",
  "type": "object",
  "required": ["name", "version", "trigger", "category"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "description": "Nome único da skill (lowercase, hyphens)"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Versão semântica (MAJOR.MINOR.PATCH)"
    },
    "trigger": {
      "type": "string",
      "maxLength": 57,
      "description": "Gatilho auto-contido (primeiros 57 chars visíveis no index)"
    },
    "category": {
      "type": "string",
      "enum": ["devops", "research", "creative", "productivity", "software-development", "media", "note-taking", "email", "orchestration"]
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {"type": "string"},
          "required": {"type": "boolean"},
          "description": {"type": "string"}
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"}
    },
    "verify_cmd": {
      "type": "string",
      "description": "Comando de verificação pós-execução (Goal-Contract)"
    }
  }
}
